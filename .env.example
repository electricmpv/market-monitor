# ============================================================================
# Market Monitor 环境变量配置
# ============================================================================

# === GitHub OAuth 认证 ===
GITHUB_CLIENT_ID=<your_github_oauth_client_id>
GITHUB_CLIENT_SECRET=<your_github_oauth_client_secret>
GITHUB_ALLOWED_USERS=electricmpv  # 允许访问的 GitHub 用户名（逗号分隔）

# === JWT Token 配置 ===
JWT_SECRET=<random_secret_key_use_openssl_rand_hex_32>
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720  # Token 有效期（30天）

# === 前端 URL（用于 OAuth 回调） ===
FRONTEND_URL=https://your-domain.com

# === LLM Configuration ===
# 选择一个提供商: openai, anthropic, deepseek
LLM_PROVIDER=deepseek

# OpenAI/Codex (如果使用)
OPENAI_API_KEY=sk-...

# Anthropic Claude (如果使用)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek (如果使用)
DEEPSEEK_API_KEY=sk-...

# === 语雀 ===
YUQUE_TOKEN=EmucIYlJro7ic4O4ZS6UujQZm89tXmwor7PwNYmL
YUQUE_NAMESPACE=diandongmianbao

# === Telegram ===
TELEGRAM_BOT_TOKEN=8495761885:AAFoQqcBHw46ybJFHdeKLz02zw22RsO4nFc
TELEGRAM_CHAT_ID=<your_chat_id>

# === Twitter/X (Twikit) ===
TWITTER_USERNAME=<your_twitter_username>
TWITTER_PASSWORD=<your_twitter_password>

# === Reddit (Optional) ===
REDDIT_CLIENT_ID=<your_client_id>
REDDIT_CLIENT_SECRET=<your_client_secret>
REDDIT_USER_AGENT=market_monitor/1.0

# === ChromaDB ===
CHROMADB_PATH=./chroma_db

# === 调度配置 ===
SCHEDULE_PAIN_RADAR=0 10 * * *  # 每天 10:00 运行痛点扫描
SCHEDULE_OPPORTUNITY_HUNTER=0 14 * * *  # 每天 14:00 运行机会猎手
